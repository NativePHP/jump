{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "nativephp/mobile": "dev-element as 3.99.0",
        "nativephp/mobile-biometrics": "^1.0",
        "nativephp/mobile-browser": "^1.0",
        "nativephp/mobile-camera": "^1.0",
        "nativephp/mobile-clipboard": "*",
        "nativephp/mobile-discovery": "*",
        "nativephp/mobile-geolocation": "^1.0",
        "nativephp/mobile-local-notifications": "^0.0.1",
        "nativephp/mobile-media-player": "^0.0.1",
        "nativephp/mobile-microphone": "^1.0",
        "nativephp/mobile-network": "^1.0",
        "nativephp/mobile-scanner": "^1.0",
        "nativephp/mobile-secure-storage": "^1.0",
        "nativephp/mobile-share": "^1.0",
        "nativephp/mobile-vibe": "^1.0",
        "nativephp/native-ui": "dev-main",
        "s2br/nativephp-mobile-splashscreen": "^1.3"
    },
    "repositories": {
        "clipboard": {
            "type": "path",
            "url": "../Plugins/nativephp/clipboard",
            "options": {
                "symlink": true
            }
        },
        "discovery": {
            "type": "path",
            "url": "../Plugins/nativephp/discovery",
            "options": {
                "symlink": true
            }
        },
        "mobile": {
            "type": "path",
            "url": "../mobile-air"
        },
        "ui": {
            "type": "path",
            "url": "../Plugins/nativephp/native-ui"
        },
        "plugins": {
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
