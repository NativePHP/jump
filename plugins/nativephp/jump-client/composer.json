{
    "name": "nativephp/jump-client",
    "description": "Jump session client for NativePHP Mobile - connects to a native:jump dev server and renders the developer's app in place, with a 3-finger swipe to exit back to Jump",
    "type": "nativephp-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "NativePHP",
            "email": "support@nativephp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^2.7|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "NativePHP\\JumpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NativePHP\\JumpClient\\JumpClientServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
